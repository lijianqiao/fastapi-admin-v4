# Runtime profile: development | test | production
ENVIRONMENT=development
DEBUG=false

# PostgreSQL runtime role (DML only). Percent-encode reserved characters.
DATABASE_URL=postgresql+psycopg://fastapi_admin_app:change-me@localhost:5432/fastapi_admin
# Inject this only into the one-off Alembic process in production. Never expose
# the privileged migration credential to a long-running web worker.
# MIGRATION_DATABASE_URL=postgresql+psycopg://fastapi_admin_migrator:change-me@localhost:5432/fastapi_admin
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# In development, omit SECRET_KEY to use an ephemeral key on each process start.
# Production must provide a cryptographically random value of at least 32 chars:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
ALGORITHM=HS256
JWT_ISSUER=fastapi-admin
JWT_AUDIENCE=fastapi-admin-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SESSION_REPLAY_GRACE_DAYS=1
REFRESH_SESSION_HISTORY_RETENTION_DAYS=30
REFRESH_SESSION_CLEANUP_BATCH_SIZE=1000

# Authentication protection. A shared gateway limiter is still recommended for
# multi-process or multi-instance production deployments.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
PASSWORD_HASH_MAX_CONCURRENCY=4
PASSWORD_HASH_QUEUE_TIMEOUT_SECONDS=5
REGISTRATION_ENABLED=false

# Browser and reverse-proxy policy.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Set true only while debugging SQL; keeps sqlalchemy.engine off the console otherwise.
SQL_ECHO=false
API_V1_PREFIX=/api/v1

# One-time bootstrap. Leave unset during normal application startup. The script
# refuses to promote or overwrite an existing account.
# INIT_SUPERUSER_USERNAME=admin
# INIT_SUPERUSER_EMAIL=admin@example.com
# INIT_SUPERUSER_PASSWORD=
